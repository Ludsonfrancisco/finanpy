  "fixed_sql": [
    {
      "name": "households",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"households\" (\"uuid\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"uuid\"));"
        }
      ]
    },
    {
      "name": "owners",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"owners\" (\"uuid\" TEXT NOT NULL, \"type\" TEXT NOT NULL CHECK(\"type\" IN ('self', 'spouse', 'shared')), \"name\" TEXT NOT NULL, PRIMARY KEY (\"uuid\"));"
        }
      ]
    },
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"uuid\" TEXT NOT NULL, \"household_uuid\" TEXT NOT NULL REFERENCES households (uuid) ON UPDATE CASCADE ON DELETE RESTRICT, \"financial_owner_uuid\" TEXT NOT NULL REFERENCES owners (uuid) ON UPDATE CASCADE ON DELETE RESTRICT, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL CHECK(\"type\" IN ('checking', 'savings', 'cash', 'credit', 'investment', 'other')), \"initial_balance_minor\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL, \"version\" INTEGER NOT NULL CHECK(\"version\" >= 1), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"uuid\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"uuid\" TEXT NOT NULL, \"household_uuid\" TEXT NOT NULL REFERENCES households (uuid) ON UPDATE CASCADE ON DELETE RESTRICT, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL CHECK(\"type\" IN ('income', 'expense')), \"color\" TEXT NOT NULL, \"icon\" TEXT NULL, \"version\" INTEGER NOT NULL CHECK(\"version\" >= 1), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"uuid\"));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
